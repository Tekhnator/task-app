<?xml version="1.0" encoding="utf-8"?>
<!-- Сертификат НУЦ Минцифры нужен только для серверов GigaChat (Сбер). Для остальных сайтов — обычные системные сертификаты. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">sberbank.ru</domain>
        <domain includeSubdomains="true">giga.chat</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/russian_trusted_root_ca" />
            <certificates src="@raw/russian_trusted_sub_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
